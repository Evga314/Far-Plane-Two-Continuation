{
  "schemaVersion": 1,
  "id": "farplanetwocontinuation",
  "version": "${version}",
  "name": "FarPlaneTwo Continuation",
  "description": "Level-of-detail terrain up to the edge of the world (30 000 000 blocks). A continuation of the idea of FarPlaneTwo by DaPorkchop_. Works on PC and on Android. Install on both the client and the server; in singleplayer the client is enough. The list of commands: /FPhelp.",
  "authors": [
    "Evga314"
  ],
  "contact": {
    "homepage": "https://github.com/Evga314/Far-Plane-Two-Continuation",
    "sources": "https://github.com/Evga314/Far-Plane-Two-Continuation",
    "issues": "https://github.com/Evga314/Far-Plane-Two-Continuation/issues"
  },
  "license": "MIT",
  "icon": "assets/farplanetwocontinuation/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.Evga314.farplanetwocontinuation.Farplanetwocontinuation"
    ],
    "client": [
      "com.Evga314.farplanetwocontinuation.client.FarplanetwocontinuationClient"
    ],
    "modmenu": [
      "com.Evga314.farplanetwocontinuation.client.FarPlaneModMenu"
    ],
    "sodium:config_api_user": [
      "com.Evga314.farplanetwocontinuation.client.SodiumOptions"
    ]
  },
  "mixins": [
    "farplanetwocontinuation.mixins.json",
    {
      "config": "farplanetwocontinuation.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "farplanetwocontinuation.iris.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "sodium": "*",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
